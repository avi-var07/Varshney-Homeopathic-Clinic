# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/varshney-clinic

# ─── Session Security ─────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
# Used to HMAC-sign both doctor and patient sessions
SESSION_SECRET=replace-with-64-char-hex-secret

# ─── Doctor Email (fixed, never changes) ─────────────────────────────────────
# The doctor's registered email — OTP is sent here for login
# Must match the hardcoded value in src/lib/auth.ts
DOCTOR_EMAIL=thehomeobytes@gmail.com

# ─── Email (choose one: SMTP or Resend) ──────────────────────────────────────
# Option 1: SMTP (recommended — free with Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your@gmail.com

# Option 2: Resend (fallback)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=noreply@varshneyhomoeopathy.com

# Clinic email (where new appointment notifications are sent)
CLINIC_EMAIL=thehomeobytes@gmail.com

# ─── Cloudinary (file uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Meet (permanent clinic room) ─────────────────────────────────────
# Create one fixed Google Meet room for all online consultations
# Doctor never needs to copy/paste this — it's used automatically
PERMANENT_MEET_LINK=https://meet.google.com/your-fixed-room-code
# Must also set the public version for use in client components:
NEXT_PUBLIC_PERMANENT_MEET_LINK=https://meet.google.com/your-fixed-room-code

# ─── UPI Payment ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_UPI_ID=7388333991@paytm

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://varshneyhomoeopathy.com

# ─── Formspree (contact form) ────────────────────────────────────────────────
FORMSPREE_ENDPOINT=https://formspree.io/f/your-id

# ─── Legacy (no longer used — can be removed) ────────────────────────────────
# ADMIN_USER=drAman
# ADMIN_PASS=your-strong-password
# ADMIN_SECRET=64-char-hex-secret   (replaced by SESSION_SECRET)
